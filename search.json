---
layout: null
---
[
  {% for post in site.posts %}
    {
      "title"    : "{{ post.title | escape }}",
      "category" : "Blog",
      "url"      : "{{ site.baseurl }}{{ post.url }}",
      "date"     : "{{ post.date | date: "%B %d, %Y" }}",
      "content"  : "{{ post.content | strip_html | strip_newlines | escape }}"
    } {% unless forloop.last and site.projects.size == 0 and site.learning.size == 0 %},{% endunless %}
  {% endfor %}
  {% for project in site.projects %}
    {
      "title"    : "{{ project.title | escape }}",
      "category" : "Project",
      "url"      : "{{ site.baseurl }}{{ project.url }}",
      "date"     : "",
      "content"  : "{{ project.content | strip_html | strip_newlines | escape }}"
    } {% unless forloop.last and site.learning.size == 0 %},{% endunless %}
  {% endfor %}
  {% for learn in site.learning %}
    {
      "title"    : "{{ learn.title | escape }}",
      "category" : "Learning",
      "url"      : "{{ site.baseurl }}{{ learn.url }}",
      "date"     : "",
      "content"  : "{{ learn.content | strip_html | strip_newlines | escape }}"
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}
]

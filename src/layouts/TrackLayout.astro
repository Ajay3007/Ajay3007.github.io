---
/**
 * A track landing page.
 *
 * The body is still the migrated Jekyll roadmap markup; Phase 8 replaces it
 * with a view derived from the track's modules and concepts. The sidebar
 * listing below is already derived, so the two can be compared side by side
 * before the hand-built version is retired.
 */
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import MathStyles from '../components/MathStyles.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import StatusChip from '../components/ui/StatusChip.astro';
import { DOMAIN_LABELS } from '../consts';
import { getCollection } from 'astro:content';
import ProgressStore from '../components/learning/ProgressStore.astro';
import ProgressBar from '../components/learning/ProgressBar.astro';
import { getConcepts, conceptUrl, type Track } from '../lib/content';

interface Props { track: Track; headings: MarkdownHeading[] }
const { track } = Astro.props;
const d = track.data;
const concepts = await getConcepts({ track: track.id });

/**
 * Group by module for display. Modules never appear in URLs, so this grouping
 * can be reorganised without breaking a link — concepts with no module fall
 * into one unnamed run at the end rather than being hidden.
 */
const allModules = await getCollection('modules');
const modules = allModules
  .filter((m) => m.data.track === track.id)
  .sort((a, b) => a.data.order - b.data.order);

const grouped = modules
  .map((m) => ({ module: m, items: concepts.filter((c) => c.data.module === m.data.slug) }))
  .filter((g) => g.items.length > 0);

const moduleSlugs = new Set(modules.map((m) => m.data.slug));
const ungrouped = concepts.filter((c) => !c.data.module || !moduleSlugs.has(c.data.module));
---

<BaseLayout title={d.title} description={d.description} tags={d.tags}>
  <MathStyles />
  <ProgressStore />
  <div class="mx-auto max-w-(--container-wide) px-5 pt-10 sm:px-8">
    <Breadcrumb
      items={[
        { label: 'Learning', href: '/learning/' },
        { label: DOMAIN_LABELS[d.domain] ?? d.domain, href: `/learning/${d.domain}/` },
        { label: d.title },
      ]}
    />
    <header class="mt-6">
      <p class="font-mono text-[12px] tracking-wide text-subtle uppercase">// TRACK</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-fg sm:text-4xl">{d.title}</h1>
      <p class="mt-3 max-w-(--container-prose) text-[17px] leading-relaxed text-muted">{d.tagline}</p>
      <p class="mt-3 text-[13px] text-subtle">{concepts.length} pages in this track</p>
      <div class="mt-4 max-w-sm">
        <ProgressBar ids={concepts.map((c) => c.id)} label="Completed" />
      </div>
    </header>

    {
      grouped.map(({ module, items }) => (
        <section class="mt-8">
          <div class="flex items-baseline gap-3">
            {module.data.stage && (
              <span class="font-mono text-[11px] tracking-wide text-subtle uppercase">
                {module.data.stage}
              </span>
            )}
            <h2 class="text-[15px] font-semibold text-fg">{module.data.title}</h2>
            <span class="ml-auto font-mono text-[11px] text-subtle">{items.length}</span>
          </div>
          <p class="mt-1 text-[13.5px] text-subtle">{module.data.description}</p>
          <ol class="mt-3 grid gap-2 sm:grid-cols-2">
            {items.map((c) => (
              <li>
                <a
                  href={conceptUrl(c)}
                  data-done-tick={c.id}
                  class="flex items-baseline gap-3 rounded border border-line px-3 py-2 transition-colors hover:border-accent-border [&.is-done]:border-accent-border"
                >
                  <span class="font-mono text-[12px] text-subtle">{String(c.data.order).padStart(2, '0')}</span>
                  <span class="text-[15px] text-fg">{c.data.title}</span>
                  <span class="ml-auto shrink-0"><StatusChip status={c.data.status} showLabel={false} /></span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    {
      ungrouped.length > 0 && (
        <section class="mt-8">
          {grouped.length > 0 && (
            <h2 class="text-[15px] font-semibold text-fg">Other pages</h2>
          )}
          <ol class="mt-3 grid gap-2 sm:grid-cols-2">
            {ungrouped.map((c) => (
              <li>
                <a
                  href={conceptUrl(c)}
                  data-done-tick={c.id}
                  class="flex items-baseline gap-3 rounded border border-line px-3 py-2 transition-colors hover:border-accent-border [&.is-done]:border-accent-border"
                >
                  <span class="font-mono text-[12px] text-subtle">{String(c.data.order).padStart(2, '0')}</span>
                  <span class="text-[15px] text-fg">{c.data.title}</span>
                  <span class="ml-auto shrink-0"><StatusChip status={c.data.status} showLabel={false} /></span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <div class="legacy-content prose dark:prose-invert mt-10 max-w-none prose-a:text-accent prose-code:before:content-none prose-code:after:content-none">
      <slot />
    </div>
  </div>
</BaseLayout>

---
/**
 * The site shell: head, SEO, theme, header, footer.
 *
 * Every page renders through this. The SEO block replaces the hand-rolled meta
 * tags in the Jekyll _layouts/default.html, with two fixes carried in from the
 * audit: `description` is required by the content schemas (354 Jekyll pages
 * shared one meta description), and the OG image now exists.
 */
import '../styles/global.css';
import { SITE, NAV } from '../consts';

interface Props {
  title: string;
  description: string;
  /** 'article' for concepts and posts, 'website' for indexes. */
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  tags?: string[];
  /** Set false on index pages so Pagefind indexes real content only. */
  indexable?: boolean;
}

const {
  title,
  description,
  type = 'website',
  publishedAt,
  updatedAt,
  tags = [],
  indexable = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(SITE.ogImage, Astro.site).href;
const fullTitle = title === SITE.title ? SITE.title : `${title} | ${SITE.title}`;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={SITE.lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={SITE.title} />
    <meta property="og:locale" content={SITE.locale} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} — Blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Theme applied before first paint so there is no flash. Dark is the
        site's identity, so it is the default when nothing is stored. */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const dark = stored ? stored === 'dark' : true;
          document.documentElement.classList.toggle('dark', dark);
        } catch {
          /* private mode — keep the dark default already on <html> */
        }
      })();
    </script>
  </head>

  <body class="min-h-screen bg-bg font-sans antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-surface focus:px-4 focus:py-2 focus:text-fg"
    >
      Skip to content
    </a>

    <header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-(--container-wide) items-center gap-6 px-5 sm:px-8">
        <a href="/" class="flex items-center gap-2.5 font-semibold text-fg" aria-label={`${SITE.title} home`}>
          <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
            <rect x="1" y="1" width="20" height="20" stroke="var(--accent)" stroke-opacity="0.4" fill="none" />
            <rect x="5" y="5" width="12" height="12" stroke="var(--accent)" fill="none" />
            <circle cx="11" cy="11" r="2" fill="var(--accent)" />
          </svg>
          <span>{SITE.title}</span>
        </a>

        <nav id="site-nav" class="hidden gap-5 text-[13.5px] md:flex" aria-label="Main">
          {
            NAV.map((item) => {
              const active = currentPath === item.href || currentPath.startsWith(item.href);
              return (
                <a
                  href={item.href}
                  class:list={[
                    'transition-colors hover:text-fg',
                    active ? 'font-semibold text-accent' : 'text-muted',
                  ]}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.label}
                </a>
              );
            })
          }
        </nav>

        <div class="ml-auto flex items-center gap-2">
          <button
            type="button"
            id="nav-toggle"
            class="rounded border border-line px-2 py-1 text-[12px] text-muted transition-colors hover:border-line-strong hover:text-fg md:hidden"
            aria-label="Toggle navigation"
            aria-expanded="false"
            aria-controls="site-nav"
          >
            ☰
          </button>
          <button
            type="button"
            id="theme-toggle"
            class="rounded border border-line px-2 py-1 text-[12px] text-muted transition-colors hover:border-line-strong hover:text-fg"
            aria-label="Toggle colour theme"
          >
            <span class="hidden dark:inline">☀</span>
            <span class="inline dark:hidden">☾</span>
          </button>
        </div>
      </div>
    </header>

    {/* Mobile navigation. The Jekyll header lost its toggle at some point and
        left nav.js querying a .nav-toggle that no longer existed, so small
        screens had no navigation at all. */}
    <nav id="mobile-nav" class="hidden border-b border-line bg-bg md:hidden" aria-label="Main (mobile)">
      <ul class="mx-auto max-w-(--container-wide) px-5 py-2">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="block py-2 text-[15px] text-muted transition-colors hover:text-accent">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <main id="main" data-pagefind-body={indexable ? '' : undefined}>
      <slot />
    </main>

    <footer class="mt-24 border-t border-line">
      <div
        class="mx-auto flex max-w-(--container-wide) flex-col gap-2 px-5 py-8 text-[13px] text-subtle sm:flex-row sm:items-center sm:justify-between sm:px-8"
      >
        <p>© {new Date().getFullYear()} {SITE.author}</p>
        <p>Built with Astro · Hosted on GitHub Pages</p>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('nav-toggle')?.addEventListener('click', (e) => {
        const nav = document.getElementById('mobile-nav');
        const open = nav?.classList.toggle('hidden') === false;
        e.currentTarget.setAttribute('aria-expanded', String(open));
      });

      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('theme', dark ? 'dark' : 'light');
        } catch {
          /* not persisted — the toggle still works for this page view */
        }
      });
    </script>
  </body>
</html>

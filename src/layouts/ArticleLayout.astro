---
/**
 * Long-form pages that are not learning concepts: blog posts, project
 * write-ups and DSA editorials. Deliberately plainer than ConceptLayout —
 * these have no track, no prerequisites and no position in a sequence.
 */
import BaseLayout from './BaseLayout.astro';
import MathStyles from '../components/MathStyles.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import Tag from '../components/ui/Tag.astro';
import TableOfContents from '../components/ui/TableOfContents.astro';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description: string;
  kicker?: string;
  date?: Date;
  meta?: (string | undefined)[];
  tags?: string[];
  crumbs: { label: string; href?: string }[];
  headings?: MarkdownHeading[];
  links?: { label: string; href: string }[];
}
const { title, description, kicker, date, meta = [], tags = [], crumbs, headings = [], links = [] } =
  Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedAt={date}
  tags={tags}
  searchType={kicker?.startsWith('PROJECT') ? 'project' : kicker?.startsWith('LEETCODE') ? 'editorial' : 'post'}
>
  <MathStyles />
  <div class="mx-auto grid max-w-(--container-wide) gap-10 px-5 pt-10 sm:px-8 lg:grid-cols-[minmax(0,1fr)_15rem]">
    <article class="min-w-0">
      <Breadcrumb items={crumbs} />
      <header class="mt-6">
        {kicker && <p class="font-mono text-[12px] tracking-wide text-subtle uppercase">// {kicker}</p>}
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-fg sm:text-4xl">{title}</h1>
        <p class="mt-3 max-w-(--container-prose) text-[17px] leading-relaxed text-muted">{description}</p>
        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-[13px] text-subtle">
          {date && <span>{date.toISOString().slice(0, 10)}</span>}
          {meta.filter(Boolean).map((m) => <span>{m}</span>)}
        </div>
        {
          links.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-3 text-[14px]">
              {links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">
                  {l.label} ↗
                </a>
              ))}
            </div>
          )
        }
      </header>

      <div class="legacy-content prose dark:prose-invert mt-8 max-w-(--container-prose) prose-headings:scroll-mt-20 prose-a:text-accent prose-code:before:content-none prose-code:after:content-none">
        <slot />
      </div>

      {
        tags.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-2">{tags.map((t) => <Tag>{t}</Tag>)}</div>
        )
      }
    </article>
    <aside class="hidden lg:block">
      <div class="sticky top-20"><TableOfContents /></div>
    </aside>
  </div>
</BaseLayout>

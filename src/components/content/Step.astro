---
interface Props { title?: string }
const { title } = Astro.props;
---
<li class="relative [counter-increment:step] pl-10">
  <span
    class="absolute left-0 top-0 flex h-7 w-7 items-center justify-center rounded-full border border-accent-border font-mono text-[12px] text-accent before:content-[counter(step)]"
    aria-hidden="true"></span>
  {title && <p class="mb-1 font-medium text-fg">{title}</p>}
  <div class="text-[15px] leading-relaxed text-muted [&>*:first-child]:mt-0 [&>*:last-child]:mb-0">
    <slot />
  </div>
</li>

---
/** The one sentence a reader should leave with. Deliberately unstyleable
    beyond this — if everything is emphasised, nothing is. */
---
<aside class="my-6 border-l-2 border-accent pl-4">
  <p class="mb-1.5 font-mono text-[12px] tracking-wide text-accent uppercase">Key idea</p>
  <div class="text-[16px] leading-relaxed text-fg [&>*:first-child]:mt-0 [&>*:last-child]:mb-0">
    <slot />
  </div>
</aside>

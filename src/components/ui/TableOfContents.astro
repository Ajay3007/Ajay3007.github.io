---
/** "On this page", built from the headings Astro already extracted. */
import type { MarkdownHeading } from 'astro';
interface Props { headings: MarkdownHeading[] }
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---
{
  items.length > 2 && (
    <nav class="text-[13px]" aria-label="On this page">
      <p class="mb-2 font-mono text-[12px] tracking-wide text-subtle uppercase">On this page</p>
      <ul class="space-y-1.5 border-l border-line">
        {items.map((h) => (
          <li class:list={[h.depth === 3 && 'ml-3']}>
            <a
              href={`#${h.slug}`}
              class="-ml-px block border-l border-transparent pl-3 text-subtle transition-colors hover:border-accent hover:text-accent"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

---
/**
 * A list of related concepts — used for prerequisites, related and backlinks.
 * One component for all three, because the only real difference is the label.
 */
import StatusChip from './StatusChip.astro';
import { conceptUrl, type Concept } from '../../lib/content';
interface Props { title: string; concepts: Concept[]; note?: string }
const { title, concepts, note } = Astro.props;
---
{
  concepts.length > 0 && (
    <section class="mt-8">
      <h2 class="mb-1 font-mono text-[12px] tracking-wide text-subtle uppercase">{title}</h2>
      {note && <p class="mb-3 text-[13px] text-subtle">{note}</p>}
      <ul class="mt-3 space-y-2">
        {concepts.map((c) => (
          <li>
            <a
              href={conceptUrl(c)}
              class="flex items-baseline gap-3 rounded border border-line px-3 py-2 transition-colors hover:border-accent-border"
            >
              <span class="text-[15px] text-fg">{c.data.title}</span>
              <span class="ml-auto shrink-0">
                <StatusChip status={c.data.status} showLabel={false} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

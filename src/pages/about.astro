---
/**
 * About.
 *
 * The body is carried over from about.md unchanged, so it keeps the visual
 * identity it has today. It uses the c-* classes from signal.css, which
 * sync-public mirrors into public/ — the same legacy-compatibility route the
 * migrated learning pages take, and it retires when this page is rebuilt on
 * components in Phase 12.
 *
 * Jekyll served this at /about.html because about.md had no permalink. The
 * canonical URL is now /about/, with the old one redirecting.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, PROFILE } from '../consts';
---

<BaseLayout
  title="About"
  description={`${PROFILE.name} — ${PROFILE.role} at ${PROFILE.company}. ${SITE.description}`}
>
  <link rel="stylesheet" href="/assets/css/signal.css" />
  <div class="legacy-content mx-auto max-w-(--container-wide) px-5 pt-6 sm:px-8">
<section class="c-about-hero">
  <div class="c-about-grid">
    <div>
      <div class="c-kicker">// ABOUT</div>
      <h1 class="c-about-title">
        Ajay Kumar Gupt.<br>
        Engineer who reads<br>
        <span class="c-accent">man pages</span> for fun.
      </h1>
      <p class="c-about-lede">
        Five years building packet-processing pipelines for SASE —
        deep packet inspection, real-time threat detection, and the
        unglamorous plumbing that keeps traffic moving at line rate.
        Production systems at 90+ Gbps, 2 patents filed, 5–6 engineers
        mentored. Day job is C/C++ and DPDK. Off-hours, I write here so
        I learn faster and forget less.
      </p>
    </div>

    <aside class="c-whoami">
      <div class="c-whoami-head">~/whoami</div>
      <table class="c-whoami-table">
        <tbody>
          <tr><td>role</td><td>Software Engineer</td></tr>
          <tr><td>level</td><td>Manager (designation)</td></tr>
          <tr><td>org</td><td>Jio Platforms</td></tr>
          <tr><td>loc</td><td>Navi Mumbai, IN</td></tr>
          <tr><td>focus</td><td>data plane</td></tr>
          <tr><td>tenure</td><td>~5 yrs</td></tr>
          <tr><td>status</td><td>open to talk</td></tr>
        </tbody>
      </table>
    </aside>
  </div>
</section>

<section class="c-section">
  <div class="c-section-head">
    <div>
      <div class="c-kicker">// TIMELINE</div>
      <h2 class="c-section-title">Where the work has happened.</h2>
    </div>
  </div>
  <div class="c-timeline">
    <div class="c-timeline-row">
      <span class="c-timeline-when">Jun 2021 — now</span>
      <span class="c-timeline-role">Software Engineer @ Jio Platforms, Navi Mumbai</span>
      <span class="c-timeline-note">SASE / DPI / DPDK — 90+ Gbps production systems, 5 releases shipped, 2 patents filed, 5–6 engineers mentored.</span>
    </div>
    <div class="c-timeline-row">
      <span class="c-timeline-when">May 2020 — Jul 2020</span>
      <span class="c-timeline-role">Student Trainee (Intern) @ Samsung R&amp;D, Noida</span>
      <span class="c-timeline-note">Android app — AR + ML face &amp; gesture detection; 90% accuracy using MediaPipe-inspired face mesh.</span>
    </div>
    <div class="c-timeline-row">
      <span class="c-timeline-when">Jun 2017 — Jun 2021</span>
      <span class="c-timeline-role">B.Tech Electronics Engineering — IIT (BHU) Varanasi</span>
      <span class="c-timeline-note">CPI 8.31 / 10.</span>
    </div>
  </div>
</section>

<section class="c-section">
  <div class="c-section-head">
    <div>
      <div class="c-kicker">// STACK</div>
      <h2 class="c-section-title">What I work in.</h2>
    </div>
  </div>
  <div class="c-card-grid c-cols-4">
    <div class="c-stack-card">
      <div class="c-stack-key">core/</div>
      <div>· DPDK</div><div>· VPP</div><div>· Hyperscan</div><div>· Linux perf</div>
    </div>
    <div class="c-stack-card">
      <div class="c-stack-key">lang/</div>
      <div>· C / C++</div><div>· Java</div><div>· Python</div><div>· Shell Scripting</div>
    </div>
    <div class="c-stack-card">
      <div class="c-stack-key">infra/</div>
      <div>· Kafka</div><div>· Redis Cluster</div><div>· Aerospike</div><div>· Docker</div>
    </div>
    <div class="c-stack-card">
      <div class="c-stack-key">tools/</div>
      <div>· Linux / Git</div><div>· Wireshark</div><div>· pktgen</div><div>· CI/CD</div>
    </div>
  </div>
</section>
  </div>
</BaseLayout>

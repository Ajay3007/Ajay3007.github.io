---
/**
 * The DSA hub.
 *
 * Replaces a migrated page that still carried Jekyll Liquid — a hand-written
 * topic grid with `{% assign %}` counts against the problems database. Every
 * number and every topic below is read from the collections, so the grid
 * cannot drift from what is actually tracked.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import Card from '../../../components/ui/Card.astro';
import StatusChip from '../../../components/ui/StatusChip.astro';
import LearningSidebar from '../../../components/ui/LearningSidebar.astro';
import ProgressStore from '../../../components/learning/ProgressStore.astro';
import { getConcepts, getTracks, conceptUrl, trackUrl } from '../../../lib/content';
import { getProblems, statsFor, TOPIC_PAGES } from '../../../lib/problems';

const [concepts, tracks, problems] = await Promise.all([
  getConcepts({ domain: 'dsa' }),
  getTracks('dsa'),
  getProblems(),
]);
const stats = statsFor(problems);

/** A topic's chapter page, if one was migrated to that URL. */
const conceptAt = (url: string) => concepts.find((c) => conceptUrl(c) === url);

const topics = TOPIC_PAGES.map((t) => {
  const items = problems.filter((p) => p.data.topics.includes(t.topic));
  return {
    ...t,
    total: items.length,
    solved: items.filter((p) => p.data.solved).length,
    concept: conceptAt(t.parent),
  };
});
---

<BaseLayout
  title="DSA & Algorithms"
  description={`${concepts.length} pages and ${stats.total} curated problems across ${topics.length} topics — ${stats.solved} solved.`}
>
  <ProgressStore />
  <div class="mx-auto grid max-w-(--container-wide) gap-10 px-5 pt-10 sm:px-8 lg:grid-cols-[13rem_minmax(0,1fr)]">
    <aside class="hidden lg:block">
      <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto pb-8">
        <LearningSidebar activeDomain="dsa" />
      </div>
    </aside>

    <div class="min-w-0">
      <Breadcrumb items={[{ label: 'Learning', href: '/learning/' }, { label: 'DSA & Algorithms' }]} />

      <header class="mt-6">
        <h1 class="text-3xl font-semibold tracking-tight text-fg sm:text-4xl">DSA &amp; Algorithms</h1>
        <p class="mt-3 max-w-(--container-prose) text-[17px] leading-relaxed text-muted">
          {concepts.length} pages and {stats.total} curated problems. Patterns, structures and the
          proofs that make them stick.
        </p>
        <div class="mt-5 flex flex-wrap gap-x-8 gap-y-3">
          <div><div class="text-2xl font-semibold text-fg">{stats.total}</div><div class="text-[12px] text-subtle">Problems</div></div>
          <div><div class="text-2xl font-semibold text-ok">{stats.solved}</div><div class="text-[12px] text-subtle">Solved</div></div>
          <div><div class="text-2xl font-semibold text-fg">{stats.percent}%</div><div class="text-[12px] text-subtle">Complete</div></div>
          <div><div class="text-2xl font-semibold text-fg">{concepts.length}</div><div class="text-[12px] text-subtle">Pages</div></div>
        </div>
        <div class="mt-5 flex flex-wrap gap-3 text-[13px]">
          <a href="/problems/" class="text-accent hover:underline">All problems →</a>
          {tracks.map((t) => <a href={trackUrl(t)} class="text-accent hover:underline">{t.data.title} →</a>)}
        </div>
      </header>

      <h2 class="mt-10 font-mono text-[12px] tracking-wide text-subtle uppercase">Topics</h2>
      <ul class="mt-3 grid gap-3 sm:grid-cols-2">
        {
          topics.map((t) => (
            <li>
              <Card class="h-full">
                <div class="flex items-baseline gap-2">
                  <a href={t.parent} class="text-[15px] font-medium text-fg hover:text-accent">{t.title}</a>
                  {t.concept && <StatusChip status={t.concept.data.status} showLabel={false} />}
                  <span class="ml-auto font-mono text-[11px] text-subtle">{t.solved}/{t.total}</span>
                </div>
                <div class="mt-2 flex gap-3 text-[13px]">
                  <a href={t.url} class="text-accent hover:underline">Problems →</a>
                  {t.concept && <a href={t.parent} class="text-subtle hover:text-accent">Notes →</a>}
                </div>
              </Card>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>

---
/**
 * The learning hub.
 *
 * Jekyll's version hand-listed ten topic cards with hand-written blurbs, and a
 * second identical grid lived on the homepage. Both are derived here: adding a
 * domain to consts.DOMAINS puts it on this page, with a real count.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/ui/Card.astro';
import StatusChip from '../../components/ui/StatusChip.astro';
import ProgressStore from '../../components/learning/ProgressStore.astro';
import ProgressBar from '../../components/learning/ProgressBar.astro';
import { DOMAIN_GROUPS, SITE } from '../../consts';
import { getConcepts, getTracks, conceptUrl, trackUrl } from '../../lib/content';

const [concepts, tracks] = await Promise.all([getConcepts(), getTracks()]);
const countFor = (d: string) => concepts.filter((c) => c.data.domain === d).length;
const tracksFor = (d: string) => tracks.filter((t) => t.data.domain === d);

const recent = [...concepts]
  .filter((c) => c.data.updated)
  .sort((a, b) => (b.data.updated!.valueOf() ?? 0) - (a.data.updated!.valueOf() ?? 0))
  .slice(0, 6);

/** Concepts the author has actually claimed to be working through. */
const inProgress = concepts.filter((c) => c.data.status === 'learning').slice(0, 6);
---

<BaseLayout
  title="Learning"
  description={`${concepts.length} pages across ${DOMAIN_GROUPS.flatMap((g) => g.domains).length} knowledge domains and ${tracks.length} tracks. ${SITE.tagline}`}
  indexable={false}
>
  <ProgressStore />
  <section class="mx-auto max-w-(--container-wide) px-5 pt-12 sm:px-8">
    <p class="font-mono text-[12px] tracking-wide text-subtle uppercase">// NOTEBOOK</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-fg sm:text-4xl">Learning</h1>
    <p class="mt-3 max-w-(--container-prose) text-[17px] leading-relaxed text-muted">
      {concepts.length} pages across {tracks.length} tracks. Everything below is generated from
      the content itself — adding a page files it in the right place.
    </p>

    {
      inProgress.length > 0 && (
        <div class="mt-8 rounded-card border border-accent-border bg-accent-tint p-5">
          <p class="font-mono text-[12px] tracking-wide text-subtle uppercase">Currently learning</p>
          <ul class="mt-3 grid gap-2 sm:grid-cols-2">
            {inProgress.map((c) => (
              <li>
                <a href={conceptUrl(c)} class="text-[15px] text-fg hover:text-accent">
                  {c.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      DOMAIN_GROUPS.map(({ group, domains }) => {
        const populated = domains.filter((d) => countFor(d.slug) > 0);
        return (
          populated.length > 0 && (
            <>
              <h2 class="mt-12 font-mono text-[12px] tracking-wide text-subtle uppercase">{group}</h2>
              <ul class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                {populated.map((d) => {
                  const ids = concepts.filter((c) => c.data.domain === d.slug).map((c) => c.id);
                  return (
                    <li>
                      <Card href={`/learning/${d.slug}/`} class="h-full">
                        <div class="flex items-baseline gap-2">
                          <span class="text-[15px] font-medium text-fg">{d.label}</span>
                          <span class="ml-auto font-mono text-[11px] text-subtle">{ids.length}</span>
                        </div>
                        <p class="mt-1 text-[13.5px] leading-relaxed text-subtle">{d.blurb}</p>
                        {tracksFor(d.slug).length > 0 && (
                          <p class="mt-2 font-mono text-[11px] text-subtle">
                            {tracksFor(d.slug).map((t) => t.data.title).join(' · ')}
                          </p>
                        )}
                        <div class="mt-3">
                          <ProgressBar ids={ids} label="Completed" />
                        </div>
                      </Card>
                    </li>
                  );
                })}
              </ul>
            </>
          )
        );
      })
    }

    {
      recent.length > 0 && (
        <>
          <h2 class="mt-12 font-mono text-[12px] tracking-wide text-subtle uppercase">Recently updated</h2>
          <ul class="mt-3 space-y-2">
            {recent.map((c) => (
              <li>
                <a
                  href={conceptUrl(c)}
                  class="flex items-baseline gap-3 rounded border border-line px-3 py-2 transition-colors hover:border-accent-border"
                >
                  <span class="text-[15px] text-fg">{c.data.title}</span>
                  <span class="ml-auto shrink-0 font-mono text-[12px] text-subtle">
                    {c.data.updated!.toISOString().slice(0, 10)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>
</BaseLayout>
